-- ==========================================
-- OTIMIZAÇÕES PARA DELTA EXECUTOR
-- ==========================================
-- O Delta Executor possui melhor performance com task.wait() do que wait()
-- A interface foi ajustada para evitar crash em dispositivos Android

local function deltaOptimization()
    if identifyexecutor and identifyexecutor() == "delta" then
        notify("Delta Executor Detectado: Otimizando Performance...")
        -- Ajustes específicos de renderização para Delta
        settings().Rendering.QualityLevel = 1
    end
end

deltaOptimization()

