-- Função para alternar estado visual do botão
local function toggleButton(btn, state)
    if state then
        TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = COLORS.Accent}):Play()
    else
        TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = COLORS.Surface}):Play()
    end
end

-- Sistema de Notificação
local function notify(msg)
    local n = Instance.new("TextLabel")
    n.Size = UDim2.new(0, 200, 0, 30)
    n.Position = UDim2.new(0.5, -100, 0.8, 0)
    n.BackgroundColor3 = Color3.new(0,0,0)
    n.TextColor3 = COLORS.Accent
    n.Text = msg
    n.Font = Enum.Font.GothamBold
    n.Parent = screenGui
    
    TweenService:Create(n, TweenInfo.new(0.5), {Position = UDim2.new(0.5, -100, 0.7, 0)}):Play()
    task.delay(2, function()
        TweenService:Create(n, TweenInfo.new(0.5), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
        task.wait(0.5)
        n:Destroy()
    end)
end

-- [AUTO FARM COINS]
-- Procura por moedas no workspace e teleporta/coleta
local function doCoinsFarm()
    while States.Coins or States.FastCoins do
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "Coin" or v:FindFirstChild("Coin") then
                if not States.FastCoins then
                    -- Coleta normal: caminha até a moeda
                    player.Character.Humanoid:MoveTo(v.Position)
                    player.Character.Humanoid.MoveToFinished:Wait()
                else
                    -- Fast Coins: Teleporte rápido (Delta Executor compatible)
                    player.Character.HumanoidRootPart.CFrame = v.CFrame
                end
            end
        end
        task.wait(0.1)
    end
end

-- [AUTO FARM LEVEL / DUMMIES]
-- Localiza o Dummy mais próximo e ataca
local function doDummyFarm(safeMode)
    while States.DummyGrind or States.SafeDummy or States.LevelFarm do
        local target = nil
        local dist = math.huge
        
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "Dummy" or v:FindFirstChild("Humanoid") and v.Parent.Name == "Dummy" then
                local d = (player.Character.HumanoidRootPart.Position - v.PrimaryPart.Position).Magnitude
                if d < dist then
                    dist = d
                    target = v
                end
            end
        end

        if target then
            if safeMode then
                -- Safe Mode: Mantém distância segura
                player.Character.HumanoidRootPart.CFrame = target.PrimaryPart.CFrame * CFrame.new(0, 0, 5)
            else
                -- Aggressive: Cola no Dummy
                player.Character.HumanoidRootPart.CFrame = target.PrimaryPart.CFrame
            end
            
            -- Simula ataque (clique remoto)
            local tool = player.Character:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
        end
        task.wait(0.1)
    end
end

-- [BOSS TRACKER]
