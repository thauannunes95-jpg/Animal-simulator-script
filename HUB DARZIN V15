-- Lógica Spawn Moedas (Via Remote)
btnSpawn.MouseButton1Click:Connect(function()
    States.Spawn = not States.Spawn
    btnSpawn.Text = "Gerar Moedas: " .. (States.Spawn and "ON" or "OFF")
    btnSpawn.BackgroundColor3 = States.Spawn and THEME.Accent or THEME.Background
    
    if States.Spawn then
        task.spawn(function()
            while States.Spawn do
                -- Tenta disparar evento de coleta/geração se existir
                local remote = game:GetService("ReplicatedStorage"):FindFirstChild("CollectCoin", true) or 
                               game:GetService("ReplicatedStorage"):FindFirstChild("CoinEvent", true)
                if remote and remote:IsA("RemoteEvent") then
                    remote:FireServer()
                end
                task.wait(States.Interval / 1000)
            end
        end)
    end
end)

btnPlus.MouseButton1Click:Connect(function()
    States.Interval = States.Interval + 50
    msInput.Text = tostring(States.Interval)
end)

btnMinus.MouseButton1Click:Connect(function()
    States.Interval = math.max(10, States.Interval - 50)
    msInput.Text = tostring(States.Interval)
end)

btnHide.MouseButton1Click:Connect(function()
    States.Hide = not States.Hide
    btnHide.Text = "Hide Moedas: " .. (States.Hide and "ON" or "OFF")
    btnHide.BackgroundColor3 = States.Hide and THEME.Accent or THEME.Background
    for _, v in pairs(workspace:GetDescendants()) do
