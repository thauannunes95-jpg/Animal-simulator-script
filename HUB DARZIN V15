-- Lógica Insta Kill (Ataque Rápido)
btnInstaKill.MouseButton1Click:Connect(function()
    States.InstaKill = not States.InstaKill
    btnInstaKill.Text = "Insta Kill: " .. (States.InstaKill and "ON" or "OFF")
    btnInstaKill.BackgroundColor3 = States.InstaKill and THEME.Accent or THEME.Background
    
    if States.InstaKill then
        task.spawn(function()
            while States.InstaKill do
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("Model") and v.Name:find("Boss") then
                            local bRoot = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
                            if bRoot then
                                char.HumanoidRootPart.CFrame = bRoot.CFrame * CFrame.new(0, 0, 2)
                                local tool = char:FindFirstChildOfClass("Tool")
                                if tool then tool:Activate() end
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)

