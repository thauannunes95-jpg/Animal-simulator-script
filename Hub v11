-- Função para alternar estado visual do botão
local function toggleButton(btn, state)
    if state then
        TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = COLORS.Accent}):Play()
    else
        TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = COLORS.Surface}):Play()
    end
end

-- Sistema de Notificação
local function notify(msg)
    local n = Instance.new("TextLabel")
    n.Size = UDim2.new(0, 200, 0, 30)
    n.Position = UDim2.new(0.5, -100, 0.8, 0)
    n.BackgroundColor3 = Color3.new(0,0,0)
    n.TextColor3 = COLORS.Accent
    n.Text = msg
    n.Font = Enum.Font.GothamBold
    n.Parent = screenGui
    
    TweenService:Create(n, TweenInfo.new(0.5), {Position = UDim2.new(0.5, -100, 0.7, 0)}):Play()
    task.delay(2, function()
        TweenService:Create(n, TweenInfo.new(0.5), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
        task.wait(0.5)
        n:Destroy()
    end)
end

-- [AUTO FARM COINS]
-- Procura por moedas no workspace e teleporta/coleta
local function doCoinsFarm()
    while States.Coins or States.FastCoins do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            for _, v in pairs(workspace:GetDescendants()) do
                if (v.Name == "Coin" or v:FindFirstChild("Coin")) and v:IsA("BasePart") then
                    if not States.FastCoins then
                        char.Humanoid:MoveTo(v.Position)
                        char.Humanoid.MoveToFinished:Wait()
                    else
                        root.CFrame = v.CFrame
                    end
                end
                if not (States.Coins or States.FastCoins) then break end
            end
        end
        task.wait(0.1)
    end
end

-- [AUTO FARM LEVEL / DUMMIES]
-- Localiza o Dummy mais próximo e ataca
local function doDummyFarm(safeMode)
    while States.DummyGrind or States.SafeDummy or States.LevelFarm do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        
        if root and hum and hum.Health > 0 then
            local target = nil
            local dist = math.huge
            
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Model") and (v.Name == "Dummy" or v:FindFirstChild("Humanoid")) then
                    local tRoot = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
                    if tRoot then
                        local d = (root.Position - tRoot.Position).Magnitude
                        if d < dist then
                            dist = d
                            target = v
                        end
                    end
                end
            end

            if target then
                local tRoot = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
                if safeMode then
                    root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 5)
                else
                    root.CFrame = tRoot.CFrame
                end
                
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
            end
        end
        task.wait(0.1)
    end
end

-- [BOSS TRACKER]
local function trackBosses()
    local bossesFound = 0
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name:find("Boss") then 
            bossesFound = bossesFound + 1 
        end
    end
    notify("Bosses Ativos no Mapa: " .. bossesFound)
end

